{
  "manifest_version": 3,
  "name": "Lexie - Resumo de Consultas",
  "version": "1.0.0",
  "description": "Grava o áudio da aba atual e gera resumos de consultas nutricionais automaticamente.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:8000/*" 
  ],
  "background": {
    "service_worker": "background.js"
  }
}